# API Gateway (docker compose exposes the microservices gateway on :8080)
VITE_API_BASE_URL=http://localhost:8080/api

# Midtrans Payment Gateway
VITE_MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here

# For production, point this to the public API Gateway
# VITE_API_BASE_URL=https://api.ambilfoto.com/api
# VITE_MIDTRANS_CLIENT_KEY=your_production_midtrans_client_key
